# ==========================================
# SMARTPREDICT — CONFIGURAÇÃO MQTT
# ==========================================

MQTT_BROKER=seu-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USUARIO=seu_usuario_mqtt
MQTT_SENHA=sua_senha_mqtt

# ==========================================
# PAINEL WEB
# ==========================================

WEB_PORT=5000
WEB_USUARIO=admin
WEB_SENHA=troque_por_uma_senha_forte

# URL do painel da ESP32 (opcional)
ESP32_PANEL_URL=

# ==========================================
# GRAVAÇÃO DE DADOS
# ==========================================

# 0 = inicia com a gravação pausada
# 1 = inicia gravando
SALVAR_AO_INICIAR=0
